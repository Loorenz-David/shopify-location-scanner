# OS
.DS_Store

# secrets / env
.env
*.env
**/.env
**/*.env
secrets/

# databases
# Every local SQLite artefact, not just the three exact names: a backup copy
# (dev.db.pre-migration, dev.db.backup-<timestamp> from secrets/download-db-backup.sh)
# is hundreds of MB and GitHub rejects any push carrying one.
dev.db*

# dependencies
node_modules/
**/node_modules/

# deploy staging (CI-built artifacts uploaded to the server)
.deploy/

# build output
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# generated
src/generated/prisma/
**/src/generated/prisma/

# logs
ec2-logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# local files
*.local

