NODE_ENV=production
PORT=4000

# When frontend and backend are on the same domain (e.g. EC2 reverse proxy),
# FRONTEND_URL and SHOPIFY_APP_URL should be the same domain.
# BACKEND_PUBLIC_URL can be omitted in that case — SHOPIFY_APP_URL is used as fallback.
FRONTEND_URL=https://your-domain.com
FRONTEND_URLS=https://your-domain.com

DATABASE_URL=file:/var/lib/item-scanner/data/app.db
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_KEY=replace_with_admin_creation_key

SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
# Must match exactly what is configured in Shopify Partner Dashboard → App setup → Scopes
SHOPIFY_SCOPES=read_orders,read_products,write_products,write_metafields
# Must match the App URL in Shopify Partner Dashboard → URLs → App URL
# Also used as the base for the OAuth redirect_uri (/api/shopify/oauth/callback)
SHOPIFY_APP_URL=https://your-domain.com
# Only set if backend runs on a different domain than the frontend.
# Leave unset when frontend and backend share the same domain.
# BACKEND_PUBLIC_URL=https://api.your-domain.com
SHOPIFY_API_VERSION=2025-10
SHOPIFY_METAFIELD_NAMESPACE=app
SHOPIFY_METAFIELD_KEY=item_location
# Temporarily set to true ONLY for debugging OAuth HMAC failures. Remove/set to false after diagnosis.
# SHOPIFY_DEBUG_SKIP_HMAC=true

VAPID_PUBLIC_KEY=          # generate once per deployment: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- Queues, outbound signalling and inbound API access ------------------------

# BullMQ (webhook, notification and outbound-webhook workers) and the WS presence
# registry. All three workers and the API must point at the same instance.
REDIS_URL=redis://127.0.0.1:6379

# How often the outbound worker pushes stock demand to Manager, in ms.
# Default 900000 (15 min). Stock edits and scans trigger a sync immediately;
# this interval is the safety net that heals anything a signal missed, so it can
# be raised on a quiet shop without losing correctness.
MANAGER_SYNC_INTERVAL_MS=900000

# How long OutboundWebhookDelivery rows are kept, in days. Default 30.
# This is the audit trail behind GET /api/outbound-webhooks/deliveries, and the
# §12A.7 re-drive only looks back 7 days, so 30 leaves plenty of room.
# ManagerStockLedger rows are never pruned.
OUTBOUND_DELIVERY_RETENTION_DAYS=30

# INBOUND key: what another system must present to call Scanner's /api/external
# routes, as `x-api-key` or `Authorization: Bearer <key>`. Required — the app
# will not start without it, and it must be at least 32 characters.
#
# The key Scanner SENDS to Manager is NOT configured here. It lives per target in
# OutboundWebhookTarget.secret and is set when the target is registered with
# POST /api/outbound-webhooks. That lets each shop and each event type carry its
# own key, and lets a key be rotated by re-registering the target — no redeploy,
# and the next attempt picks it up because the secret is read at send time.
EXTERNAL_API_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Beyo Vintage purchase API — extra item attributes looked up by barcode.
# The key is optional: without it the lookup is skipped and the app still boots.
# BEYO_VINTAGE_API_KEY=
BEYO_VINTAGE_API_URL=https://api.beyovintage.se
BEYO_VINTAGE_API_TIMEOUT_MS=4000

# Debug switches, both default false. Set only while diagnosing, then remove.
# SHOPIFY_DEBUG_SKIP_HMAC=true        # skips OAuth HMAC verification
# SHOPIFY_DEBUG_ORDER_WEBHOOKS=true   # verbose logging of order webhook payloads
